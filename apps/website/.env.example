# ==============================================================================
# Tenaciti Website — Production Environment Variables
# ==============================================================================
# Configure these variables in Vercel Project Settings → Environment Variables
# for the `tenaciti-website` project (Root Directory: apps/website).

# 1. Authenticated Student Application URL (used for Login / Signup / CTA links)
NEXT_PUBLIC_APP_URL=https://my.tenaciti.app

# 2. Backend API Endpoint
NEXT_PUBLIC_API_URL=https://api.tenaciti.app/api/v1

# 3. Email Delivery (Resend API key used by /api/contact route)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# 4. Verified Domain Sender (matches your verified domain in Resend)
MAIL_FROM=noreply@mail.tenaciti.app
